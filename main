  <script>
    const emailPattern = /^(?!.*\.\.)(?!\.)(?!.*\.@)[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,24}$/;
    const disposableDomains = new Set([
      '10minutemail.com', 'guerrillamail.com', 'mailinator.com', 'tempmail.com', 'tempmail.io', 'yopmail.com',
      'trashmail.com', 'sharklasers.com', 'getairmail.com', 'fakeinbox.com', 'throwawaymail.com'
    ]);
    const trustedDomains = new Set([
      'gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'icloud.com', 'aol.com', 'proton.me', 'protonmail.com',
      'live.com', 'msn.com', 'zoho.com', 'fastmail.com', 'hey.com', 'mail.com', 'gmx.com', 'example.com'
    ]);
    const typoDomainMap = new Map([
      ['gmai.com', 'gmail.com'], ['gmial.com', 'gmail.com'], ['gmail.co', 'gmail.com'], ['gmail.con', 'gmail.com'],
      ['yaho.com', 'yahoo.com'], ['yahoo.co', 'yahoo.com'], ['yahho.com', 'yahoo.com'],
      ['hotnail.com', 'hotmail.com'], ['hotmai.com', 'hotmail.com'], ['outlok.com', 'outlook.com'],
      ['icloud.co', 'icloud.com'], ['protonmai.com', 'protonmail.com']
    ]);
    const roleLocalParts = new Set(['admin', 'administrator', 'billing', 'contact', 'help', 'info', 'mail', 'no-reply', 'noreply', 'office', 'root', 'sales', 'security', 'support', 'team']);
    const commonPasswords = new Set([
      'password', 'password1', 'password123', '123456', '12345678', '123456789', 'qwerty', 'qwerty123',
      'abc123', 'admin', 'admin123', 'letmein', 'welcome', 'welcome1', 'iloveyou', '111111', '000000'
    ]);
    const accountsInput = document.getElementById('accounts');
    const accountFile = document.getElementById('accountFile');
    const validateBtn = document.getElementById('validateBtn');
    const emailReportBtn = document.getElementById('emailReportBtn');
    const runNowBtn = document.getElementById('runNowBtn');
    const clearBtn = document.getElementById('clearBtn');
    const downloadLink = document.getElementById('downloadLink');
    const results = document.getElementById('results');
    const totalCount = document.getElementById('totalCount');
    const validCount = document.getElementById('validCount');
    const reviewCount = document.getElementById('reviewCount');
    const invalidCount = document.getElementById('invalidCount');
    const averageScore = document.getElementById('averageScore');
    const progress = document.querySelector('.progress');
    const progressBar = document.getElementById('progressBar');
    const liveCheck = document.getElementById('liveCheck');
    const highLog = document.getElementById('highLog');
    const realDomainCheck = document.getElementById('realDomainCheck');
    const apiStatus = document.getElementById('apiStatus');
    let csvObjectUrl = null;
    let liveTimer = null;
    let auditRunId = 0;

    function setProgress(completed, total) {
      const percent = total ? Math.round((completed / total) * 100) : 0;
      progressBar.style.width = `${percent}%`;
      progress.setAttribute('aria-valuenow', String(percent));
    }

    function maskSecret(secret) {
      if (!secret) return '';
      if (secret.length <= 2) return '*'.repeat(secret.length);
      if (secret.length <= 6) return secret[0] + '*'.repeat(secret.length - 1);
      return secret.slice(0, 2) + '*'.repeat(secret.length - 4) + secret.slice(-2);
    }

    function parseAccountLine(line) {
      if (!line.includes(':')) return [line.trim(), ''];
      const separatorIndex = line.indexOf(':');
      return [line.slice(0, separatorIndex).trim(), line.slice(separatorIndex + 1).trim()];
    }

    function getEmailParts(email) {
      const parts = email.toLowerCase().split('@');
      return {
        local: parts.length === 2 ? parts[0] : '',
        domain: parts.length === 2 ? parts[1] : ''
      };
    }

    function normalizeEmailForDuplicates(email) {
      const { local, domain } = getEmailParts(email);
      if (!local || !domain) return email;
      if (domain === 'gmail.com' || domain === 'googlemail.com') {
        return `${local.split('+')[0].replace(/\./g, '')}@gmail.com`;
      }
      return `${local.split('+')[0]}@${domain}`;
    }

    function calculateEntropyBits(password) {
      let pool = 0;
      if (/[a-z]/.test(password)) pool += 26;
      if (/[A-Z]/.test(password)) pool += 26;
      if (/\d/.test(password)) pool += 10;
      if (/[^A-Za-z0-9]/.test(password)) pool += 33;
      if (!pool || !password.length) return 0;
      return Math.round(password.length * Math.log2(pool));
    }

    function hasSequence(text) {
      const lowered = text.toLowerCase();
      const sequences = ['abcdefghijklmnopqrstuvwxyz', 'qwertyuiopasdfghjklzxcvbnm', '0123456789'];
      return sequences.some(sequence => {
        for (let index = 0; index <= sequence.length - 4; index += 1) {
          const chunk = sequence.slice(index, index + 4);
          if (lowered.includes(chunk) || lowered.includes(chunk.split('').reverse().join(''))) return true;
        }
        return false;
      });
    }

    function hasRepeatedRuns(text) {
      return /(.)\1{2,}/.test(text);
    }

    function assessPassword(password, emailLocal) {
      const issues = [];
      const warnings = [];
      let score = 45;
      const lowered = password.toLowerCase();
      const entropy = calculateEntropyBits(password);

      if (!password) {
        return { score: 0, entropy: 0, rating: 'missing', issues: ['Missing password/value'], warnings: [] };
      }

      if (password.length < 8) { issues.push('Password/value is shorter than 8 characters'); score -= 25; }
      if (password.length >= 12) score += 10;
      if (password.length >= 16) score += 8;
      if (!/[a-z]/.test(password)) { warnings.push('No lowercase letter'); score -= 5; }
      if (!/[A-Z]/.test(password)) { warnings.push('No uppercase letter'); score -= 5; }
      if (!/\d/.test(password)) { warnings.push('No number'); score -= 5; }
      if (!/[^A-Za-z0-9]/.test(password)) { warnings.push('No symbol'); score -= 7; }
      if (/\s/.test(password)) { issues.push('Password/value contains spaces'); score -= 20; }
      if (commonPasswords.has(lowered)) { issues.push('Password/value appears in the local common-password list'); score -= 35; }
      if (emailLocal && lowered.includes(emailLocal.toLowerCase().slice(0, 4))) { warnings.push('Password/value contains part of the email name'); score -= 12; }
      if (hasSequence(password)) { warnings.push('Password/value contains a keyboard/alphabet/number sequence'); score -= 10; }
      if (hasRepeatedRuns(password)) { warnings.push('Password/value contains repeated characters'); score -= 8; }
      if (entropy < 45) { warnings.push(`Low estimated entropy (${entropy} bits)`); score -= 12; }
      else if (entropy >= 75) score += 8;

      score = Math.max(0, Math.min(100, score));
      const rating = score >= 80 ? 'strong' : score >= 60 ? 'medium' : 'weak';
      if (rating === 'weak') issues.push('Password/value strength is weak');
      return { score, entropy, rating, issues, warnings };
    }

    // verbose: when true, build a trace for each validation step
    function validateAccountLine(line, index, seenEmails, seenNormalizedEmails, verbose = false) {
      const trace = [];
      trace.push(`Parsing line ${index + 1}`);
      const original = line.trim();
      const [rawEmail, password] = parseAccountLine(original);
      trace.push(`Split email/password -> email:'${rawEmail}', password length:${password ? password.length : 0}`);
      const email = rawEmail.toLowerCase();
      const { local, domain } = getEmailParts(email);
      trace.push(`Email parts -> local:'${local}', domain:'${domain}'`);
      const normalizedEmail = normalizeEmailForDuplicates(email);
      trace.push(`Normalized for duplicates -> '${normalizedEmail}'`);
      const issues = [];
      const warnings = [];
      let score = 100;

      if (!original) { issues.push('Empty line'); score -= 100; trace.push('Issue: empty line'); }
      if (!original.includes(':')) { issues.push("Missing ':' separator"); score -= 35; trace.push("Issue: missing ':' separator"); }
      if ((original.match(/:/g) || []).length > 1) { warnings.push('Multiple separators found; only the first colon was used'); score -= 6; trace.push('Warning: multiple separators'); }

      if (!email) { issues.push('Missing email'); score -= 45; trace.push('Issue: missing email'); }
      else if (!emailPattern.test(email)) { issues.push('Invalid email format'); score -= 45; trace.push('Issue: invalid email format'); }
      else {
        if (seenEmails.has(email)) { issues.push('Duplicate exact email in input'); score -= 35; trace.push('Issue: duplicate exact email'); }
        if (seenNormalizedEmails.has(normalizedEmail)) { warnings.push('Possible duplicate after provider normalization'); score -= 12; trace.push('Warning: duplicate after normalization'); }
        seenEmails.add(email);
        seenNormalizedEmails.add(normalizedEmail);

        if (disposableDomains.has(domain)) { issues.push('Disposable email domain is not accepted'); score -= 35; trace.push('Issue: disposable domain'); }
        if (typoDomainMap.has(domain)) { warnings.push(`Possible provider typo: did you mean ${typoDomainMap.get(domain)}?`); score -= 18; trace.push(`Warning: provider typo -> ${typoDomainMap.get(domain)}`); }
        if (roleLocalParts.has(local)) { warnings.push('Role/shared mailbox detected'); score -= 8; trace.push('Warning: role/shared mailbox'); }
        if (!trustedDomains.has(domain)) { warnings.push('Domain is syntactically valid but not in the trusted/common-domain list'); score -= 4; trace.push('Warning: uncommon domain'); }
      }

      const passwordAudit = assessPassword(password, local);
      trace.push(`Password audit -> rating:${passwordAudit.rating}, entropy:${passwordAudit.entropy}, score:${passwordAudit.score}`);
      issues.push(...passwordAudit.issues);
      warnings.push(...passwordAudit.warnings);
      score = Math.round(Math.max(0, Math.min(100, (score * 0.55) + (passwordAudit.score * 0.45))));

      const status = issues.length ? 'FAIL' : score >= 75 ? 'PASS' : 'REVIEW';
      const recommendation = status === 'PASS'
        ? 'No action required from local checks'
        : status === 'REVIEW'
          ? 'Review warnings and improve password/domain hygiene'
          : 'Local quality check failed; this does not verify or reject the provider account';

      if (verbose) trace.push(`Final status:${status}, final score:${score}`);

      return {
        row: index + 1,
        timestamp: new Date().toLocaleString(),
        email,
        normalized_email: normalizedEmail,
        domain,
        masked_value: maskSecret(password),
        password_rating: passwordAudit.rating,
        entropy_bits: passwordAudit.entropy,
        score,
        status,
        issues: issues.join('; ') || 'None',
        warnings: warnings.join('; ') || 'None',
        recommendation,
        trace: trace.join('\n')
      };
    }

    function csvEscape(value) {
      const text = String(value ?? '');
      if (/[",\n\r]/.test(text)) return '"' + text.replace(/"/g, '""') + '"';
      return text;
    }

    function buildCsv(rows) {
      const headers = ['row', 'timestamp', 'email', 'normalized_email', 'domain', 'masked_value', 'password_rating', 'entropy_bits', 'score', 'status', 'domain_status', 'domain_confidence', 'domain_health_score', 'mail_provider', 'provider_scope', 'account_verification', 'credential_check', 'dns_resolves', 'mx_hosts', 'smtp_connected', 'smtp_reachable', 'smtp_blocked_or_policy', 'smtp_tested', 'dkim', 'mta_sts', 'mta_sts_policy', 'tls_rpt', 'issues', 'warnings', 'recommendation'];
      const lines = [headers.join(',')];
      rows.forEach(row => {
        lines.push(headers.map(header => csvEscape(row[header])).join(','));
      });
      return lines.join('\n');
    }

    function setDownload(csvText) {
      if (csvObjectUrl) URL.revokeObjectURL(csvObjectUrl);
      const blob = new Blob([csvText], { type: 'text/csv;charset=utf-8' });
      csvObjectUrl = URL.createObjectURL(blob);
      downloadLink.href = csvObjectUrl;
      downloadLink.classList.add('ready');
    }

    function renderLog(rows, verbose) {
      const logLines = rows.map(row => {
        const marker = row.status === 'PASS' ? '✅' : row.status === 'REVIEW' ? '⚠️' : '❌';
        const localStatus = row.status === 'FAIL' && row.domain_status === 'ACTIVE'
          ? 'FAIL (local hygiene only)'
          : row.status;
        const domainLine = row.domain_status
          ? `\n   Domain: ${row.domain_status} (${row.domain_confidence || 'unknown'} confidence, health ${row.domain_health_score ?? 'n/a'}/100) | Provider: ${row.mail_provider || 'unknown'} | Scope: ${row.provider_scope || 'public infrastructure only'} | Account verification: not performed | DNS: ${row.dns_resolves || 'unknown'} | MX: ${row.mx_hosts || 'none'} | SMTP: ${row.smtp_reachable} (connected: ${row.smtp_connected || 'unknown'}, tested: ${row.smtp_tested || 'no'}, policy: ${row.smtp_blocked_or_policy || 'no'}) | DKIM: ${row.dkim || 'not found'} | MTA-STS: ${row.mta_sts || 'not found'} (${row.mta_sts_policy || 'file not checked'}) | TLS-RPT: ${row.tls_rpt || 'not found'}`
          : '\n   Domain: not checked (enable Real DNS/MX checks)';
        let line = `${marker} Row ${row.row} | ${localStatus} | Score ${row.score}/100 | ${row.email || '(missing email)'}${domainLine}\n   Issues: ${row.issues}\n   Warnings: ${row.warnings}\n   Recommendation: ${row.recommendation}`;
        if (verbose && row.trace) {
          line += `\n   Trace:\n     ${row.trace.replace(/\n/g, '\n     ')}`;
        }
        return line;
      });
      results.textContent = logLines.join('\n\n');
    }

    async function runEmailReport() {
        const firstLine = accountsInput.value.split(/\r?\n/).map(line => line.trim()).find(Boolean) || '';
        const [email] = parseAccountLine(firstLine);
        if (!email) {
          results.textContent = 'Enter an email address first. The password/value is not sent for this report.';
          return;
        }
        emailReportBtn.disabled = true;
        apiStatus.textContent = 'Checking public email-domain evidence...';
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 12000);
        try {
          if (window.location.protocol === 'file:') {
            results.textContent = 'Start server.py and open http://127.0.0.1:8765';
            return;
          }
          const response = await fetch(`/api/email-report?email=${encodeURIComponent(email)}`, {
            signal: controller.signal,
            headers: { Accept: 'application/json' }
          });
          const payload = await response.json();
          if (!response.ok || !payload.ok) {
            results.textContent = payload.error || 'Public email report failed.';
            return;
          }
          const report = payload.result;
          const domain = report.domain_report || {};
          const signals = domain.signals || {};
          results.textContent = [
            `Public report for ${report.email}`,
            `Syntax: ${report.valid_email_syntax ? 'valid' : 'invalid'}`,
            `Domain: ${report.domain || 'n/a'} | Provider: ${report.mail_provider || 'unknown'}`,
            `Google scope: ${report.google_account_scope || 'n/a'} | Address type: ${report.address_type || 'n/a'}`,
            `Deliverability signal: ${report.deliverability_signal || 'n/a'}${report.domain_suggestion ? ` | Possible typo: ${report.domain_suggestion}` : ''}`,
            `Domain status: ${String(domain.status || 'unknown').toUpperCase()} | Health: ${domain.health_score ?? 'n/a'}/100`,
            `DNS: ${signals.dns_resolves ? 'resolves' : 'not confirmed'} | MX: ${signals.mail_exchange_present ? 'present' : 'not confirmed'}`,
            report.gmail_alias_notes ? `Gmail alias notes: ${report.gmail_alias_notes.join(' ')}` : '',
            'Account verification: not performed',
            'Credential check: not performed',
            report.privacy_note
          ].join('\n');
          apiStatus.textContent = 'Public email report complete';
        } catch (error) {
          results.textContent = error.name === 'AbortError' ? 'Public email report timed out.' : `Report error: ${error.message}`;
          apiStatus.textContent = 'Public email report unavailable';
        } finally {
          clearTimeout(timeout);
          emailReportBtn.disabled = false;
        }
      }

    async function fetchDomainResult(domain) {
      if (!domain) return { error: 'No valid domain' };
      if (window.location.protocol === 'file:') {
        return { error: 'Start server.py and open http://127.0.0.1:8765' };
      }

      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 12000);
      try {
        const response = await fetch(`/api/probe?domain=${encodeURIComponent(domain)}`, {
          signal: controller.signal,
          headers: { Accept: 'application/json' }
        });
        const payload = await response.json();
        if (!response.ok || !payload.ok) return { error: payload.error || 'Domain check failed' };
        return payload.result;
      } catch (error) {
        return { error: error.name === 'AbortError' ? 'Domain check timed out' : error.message };
      } finally {
        clearTimeout(timeout);
      }
    }

    async function attachDomainResults(rows, runId) {
      const domains = [...new Set(rows.filter(row => row.domain).map(row => row.domain))];
      apiStatus.textContent = `Checking ${domains.length} domain(s)...`;
      const resultsByDomain = new Map();
      for (const [index, domain] of domains.entries()) {
        if (runId !== auditRunId) return false;
        apiStatus.textContent = `Checking domain ${index + 1}/${domains.length}: ${domain}`;
        resultsByDomain.set(domain, await fetchDomainResult(domain));
        setProgress(index + 1, domains.length);
      }
      if (runId !== auditRunId) return false;
      rows.forEach(row => {
        const result = resultsByDomain.get(row.domain);
        if (!result) return;
        if (result.error) {
          row.domain_status = `ERROR: ${result.error}`;
          row.mx_hosts = '';
          row.smtp_reachable = 'unknown';
          row.warnings = `${row.warnings}; Real domain check unavailable`;
          return;
        }
        const mx = result.mx_lookup && result.mx_lookup.mx ? result.mx_lookup.mx : [];
        row.domain_status = String(result.status || 'unknown').toUpperCase();
        row.domain_confidence = result.confidence || 'unknown';
        row.domain_health_score = result.health_score ?? 'n/a';
        row.mail_provider = result.mail_provider || 'Other/Custom';
        row.provider_scope = result.mail_provider === 'Google Workspace'
          ? 'Google-hosted mail infrastructure detected for this domain'
          : 'Public mail infrastructure classification only';
        row.account_verification = 'not_performed';
        row.credential_check = 'not_performed';
        row.dns_resolves = result.signals && result.signals.dns_resolves ? 'yes' : 'no';
        row.mx_hosts = mx.map(item => item[1]).join(' | ');
        row.smtp_connected = result.signals && result.signals.smtp_connected ? 'yes' : 'no';
        row.smtp_reachable = result.mx_probes.some(probe => probe.reachable) ? 'yes' : 'no';
        row.smtp_blocked_or_policy = result.signals && result.signals.smtp_blocked_or_policy ? 'yes' : 'no';
        row.smtp_tested = result.signals && result.signals.smtp_tested ? 'yes' : 'no';
        row.dkim = Object.keys((result.mail_security && result.mail_security.dkim) || {}).join(' | ') || 'not found';
        row.mta_sts = result.mail_security && result.mail_security.mta_sts && result.mail_security.mta_sts.txt ? 'published' : 'not found';
        row.mta_sts_policy = result.mail_security && result.mail_security.mta_sts_policy && result.mail_security.mta_sts_policy.valid ? 'valid' : 'missing/invalid';
        row.tls_rpt = result.mail_security && result.mail_security.tls_rpt && result.mail_security.tls_rpt.txt ? 'published' : 'not found';
        if (result.notes && result.notes.length) row.warnings = `${row.warnings}; ${result.notes.join('; ')}`;
      });
      apiStatus.textContent = 'Real domain checks complete';
      return true;
    }

    async function runAudit(verbose = false) {
      const runId = ++auditRunId;
      validateBtn.disabled = true;
      validateBtn.textContent = realDomainCheck.checked ? 'Checking domains...' : 'Running audit...';
      const lines = accountsInput.value.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
      setProgress(0, realDomainCheck.checked ? new Set(lines.map(line => getEmailParts(parseAccountLine(line)[0].toLowerCase()).domain).filter(Boolean)).size : 1);
      if (!lines.length) {
        results.textContent = 'No input to audit.';
        totalCount.textContent = '0';
        validCount.textContent = '0';
        reviewCount.textContent = '0';
        invalidCount.textContent = '0';
        averageScore.textContent = '0';
        setProgress(0, 0);
        downloadLink.classList.remove('ready');
        downloadLink.href = '#';
        validateBtn.disabled = false;
        validateBtn.textContent = 'Run Audit & Build CSV';
        return;
      }

      const seenEmails = new Set();
      const seenNormalizedEmails = new Set();
      const rows = lines.map((line, index) => validateAccountLine(line, index, seenEmails, seenNormalizedEmails, verbose));
      if (realDomainCheck.checked) {
        const current = await attachDomainResults(rows, runId);
        if (!current) {
          validateBtn.disabled = false;
          validateBtn.textContent = 'Run Audit & Build CSV';
          return;
        }
      }
      else apiStatus.textContent = 'Domain checks are opt-in';
      const pass = rows.filter(row => row.status === 'PASS').length;
      const review = rows.filter(row => row.status === 'REVIEW').length;
      const fail = rows.filter(row => row.status === 'FAIL').length;
      const average = Math.round(rows.reduce((sum, row) => sum + row.score, 0) / rows.length);

      totalCount.textContent = rows.length;
      validCount.textContent = pass;
      reviewCount.textContent = review;
      invalidCount.textContent = fail;
      averageScore.textContent = average;
      renderLog(rows, verbose);
      setDownload(buildCsv(rows));
      validateBtn.disabled = false;
      validateBtn.textContent = 'Run Audit & Build CSV';
    }

    validateBtn.addEventListener('click', () => runAudit(highLog.checked));
    emailReportBtn.addEventListener('click', runEmailReport);
    runNowBtn.addEventListener('click', () => {
      realDomainCheck.checked = true;
      apiStatus.textContent = 'Running real domain audit...';
      runAudit(highLog.checked);
    });

    clearBtn.addEventListener('click', () => {
      accountsInput.value = '';
      results.textContent = 'Input cleared.';
      totalCount.textContent = '0';
      validCount.textContent = '0';
      reviewCount.textContent = '0';
      invalidCount.textContent = '0';
      averageScore.textContent = '0';
      downloadLink.classList.remove('ready');
      downloadLink.href = '#';
      if (csvObjectUrl) {
        URL.revokeObjectURL(csvObjectUrl);
        csvObjectUrl = null;
      }
    });

    function scheduleLiveAudit() {
      if (!liveCheck.checked) return;
      clearTimeout(liveTimer);
      liveTimer = setTimeout(() => runAudit(highLog.checked), 600);
    }

    accountsInput.addEventListener('input', scheduleLiveAudit);
    accountFile.addEventListener('change', async () => {
      const file = accountFile.files && accountFile.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) {
        accountFile.value = '';
        results.textContent = 'File is larger than 5 MB. Choose a smaller local list.';
        return;
      }
      try {
        const text = await file.text();
        const lines = text.split(/\r?\n/).filter(line => line.trim());
        if (lines.length > 5000) {
          accountFile.value = '';
          results.textContent = 'File contains more than 5,000 non-empty lines.';
          return;
        }
        accountsInput.value = text;
        results.textContent = `Loaded ${lines.length} local line(s) from ${file.name}.`;
        scheduleLiveAudit();
      } catch (error) {
        accountFile.value = '';
        results.textContent = 'Unable to read the selected local file.';
      }
    });
    liveCheck.addEventListener('change', () => {
      if (liveCheck.checked) runAudit(highLog.checked);
    });
    highLog.addEventListener('change', () => {
      // re-run audit with new verbosity if there is input
      if (accountsInput.value.trim()) runAudit(highLog.checked);
    });
    realDomainCheck.addEventListener('change', () => {
      if (accountsInput.value.trim()) runAudit(highLog.checked);
    });

  </script>
</body>
</html>
