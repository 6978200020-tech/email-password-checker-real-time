{
  "name": "Authorized domain auditor",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "sh -c 'nohup python server.py --host 0.0.0.0 --port 8765 --no-browser >/tmp/domain-auditor.log 2>&1 &'",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Domain auditor",
      "protocol": "http",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
